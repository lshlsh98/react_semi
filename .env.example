# ================================================================
# .env.example — 배포 환경 변수 템플릿
# cp .env.example .env 후 실제 값을 채워넣으세요
# ================================================================

# ── Database (AWS RDS MySQL) ─────────────────────────────────────
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=team4
DB_USERNAME=
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_EXPIRE_HOUR=1

# ── Email (Gmail SMTP 앱 비밀번호) ───────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── AWS IAM ──────────────────────────────────────────────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2

# ── Frontend (Vite 빌드 시점에 번들에 포함됨) ────────────────────
# EC2 퍼블릭 IP 또는 도메인 (예: http://13.209.x.x:9999)
VITE_BACKSERVER=
VITE_NAVER_MAP_KEY=
VITE_GREEN_RETURN_API_KEY=
